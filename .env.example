# ==========================================
# TalentOps AI OS Mini - Environment Config
# ==========================================

# Server Settings
PORT=8000
HOST=127.0.0.1
DEBUG=True

# LLM Provider Configuration
# Supported providers: "openai", "gemini", "anthropic", "mock" (offline synthetic mode)
LLM_PROVIDER=mock

# API Keys (Required if using external LLM providers)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# LLM Model Name
LLM_MODEL=mock-evaluator-v1

# Security & Redaction Defaults
ENABLE_PII_REDACTION_DEFAULT=False
MAX_FILE_SIZE_MB=15
